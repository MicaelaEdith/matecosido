  m_Script: {fileID: 11500000, guid: 353d2a4e12c666d01be38d374ae56469, type: 3}
  m_Name: Dialogue_00
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcName: Trabajador
  npcPortrait: {fileID: 21300000, guid: e4a053cc659664922beebe8f24480c95, type: 3}
  lines:
  - speaker: 0
    text: "Mate Cosido, qu\xE9 suerte que te encuentro. Necesito pedirte un favor."
    playerTalkingVariant: 0
  - speaker: 0
    text: "Los de la empresa hace meses que nos vienen robando el sueldo. Ahora tienen
      toda la recaudaci\xF3n guardada all\xE1, en el establecimiento."
    playerTalkingVariant: 0
  - speaker: 0
    text: "Si pudieras hacerte con esa plata... hay muchas familias que te lo agradecer\xEDan."
    playerTalkingVariant: 0
  - speaker: 1
    text: "Cont\xE1 conmigo."
    playerTalkingVariant: 0
  - speaker: 0
    text: "And\xE1 con cuidado. Hay polic\xEDas vigilando el lugar."
    playerTalkingVariant: 0
  npcStopsBeingSad: 1
