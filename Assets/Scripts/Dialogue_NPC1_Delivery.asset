  npcName: Trabajador
  npcPortrait: {fileID: 21300000, guid: e4a053cc659664922beebe8f24480c95, type: 3}
  lines:
  - speaker: 1
    text: "Ac\xE1 est\xE1 la plata, consegu\xED recuperarla."
    playerTalkingVariant: 0
  - speaker: 0
    text: "\xA1Gracias, Mate Cosido! Me voy a quedar con la mitad para repartir entre los trabajadores del pueblo."
    playerTalkingVariant: 0
  - speaker: 0
    text: "La otra mitad ten\xE9s que llev\xE1rsela a un compa\xF1ero que te espera en la estaci\xF3n; viene del pueblo vecino a buscar el pago del resto."
    playerTalkingVariant: 0
  npcStopsBeingSad: 0
